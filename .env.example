# Copie para .env e preencha. O .env nunca vai para o Git.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
LIMITE_DIARIO=300
PORT=3000
# Quantos proxies existem na frente do servidor (1 na maioria das hospedagens).
# Sem isso, o limite por IP (RN25) enxerga só o IP do proxy.
TRUST_PROXY=
# Endereço do front, separado por vírgula. Use * só para teste local.
CORS_ORIGEM=
